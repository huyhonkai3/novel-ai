generator client {
    provider = "prisma-client"
    output   = "../src/generated/prisma"
}

datasource db {
    provider = "postgresql"
}

enum GenerationStatus {
    QUEUED
    RUNNING
    SUCCEEDED
    TRUNCATED
    FAILED
}

enum RevisionKind {
    MANUAL
    AI_ACCEPT
    AI_REJECT
    RESTORE
    APPROVE
}

model Novel {
    id          String    @id @default(uuid()) @db.Uuid
    title       String    @db.VarChar(300)
    description String?   @db.Text
    createdAt   DateTime  @default(now())
    updatedAt   DateTime  @updatedAt
    chapters    Chapter[]
}

model Chapter {
    id              String   @id @default(uuid()) @db.Uuid
    novelId         String   @db.Uuid
    number          Int
    title           String   @db.VarChar(300)
    sourceText      String   @db.Text
    originalChinese String?  @db.Text
    version         Int      @default(1)
    createdAt       DateTime @default(now())
    updatedAt       DateTime @updatedAt

    novel       Novel        @relation(fields: [novelId], references: [id], onDelete: Cascade)
    segments    Segment[]
    generations Generation[]
    revisions   Revision[]

    @@unique([novelId, number])
}

model Segment {
    id              String  @id @default(uuid()) @db.Uuid
    chapterId       String  @db.Uuid
    position        Int
    startOffset     Int
    endOffset       Int
    sourceText      String  @db.Text
    originalChinese String? @db.Text

    chapter     Chapter      @relation(fields: [chapterId], references: [id], onDelete: Cascade)
    generations Generation[]

    // Version chỉnh sửa độc lập với version nội dung chương.
    editVersion Int @default(0)

    draftRevisionId    String? @db.Uuid
    approvedRevisionId String? @db.Uuid

    revisions Revision[] @relation("SegmentRevisions")

    draftRevision Revision? @relation("SegmentDraft", fields: [draftRevisionId], references: [id], onDelete: SetNull)

    approvedRevision Revision? @relation("SegmentApproved", fields: [approvedRevisionId], references: [id], onDelete: SetNull)

    @@unique([chapterId, position])
    @@index([draftRevisionId])
    @@index([approvedRevisionId])
}

model Generation {
    id        String  @id @default(uuid()) @db.Uuid
    chapterId String  @db.Uuid
    segmentId String? @db.Uuid

    // Giữ ID gốc để tra lịch sử kể cả khi B2 tạo lại segment.
    segmentKey     String @db.Uuid
    chapterVersion Int
    position       Int

    // Snapshot giúp lịch sử không phụ thuộc nội dung chương hiện tại.
    sourceText      String  @db.Text
    originalChinese String? @db.Text
    promptVersion   String
    messages        Json
    parameters      Json

    model        String
    actualModel  String?
    status       GenerationStatus @default(QUEUED)
    output       String           @default("") @db.Text
    finishReason String?
    usage        Json?
    errorCode    String?
    durationMs   Int?

    createdAt  DateTime  @default(now())
    startedAt  DateTime?
    finishedAt DateTime?

    chapter Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

    // Tách lại segment vẫn giữ generation cùng snapshot của nó.
    segment Segment? @relation(fields: [segmentId], references: [id], onDelete: SetNull)

    revisions Revision[]

    @@index([segmentId])
    @@index([segmentKey, createdAt])
    @@index([chapterId, createdAt])
    @@index([status, createdAt])
}

model Revision {
    id        String  @id @default(uuid()) @db.Uuid
    chapterId String  @db.Uuid
    segmentId String? @db.Uuid

    // Không mất khả năng tra lịch sử khi B2 tạo lại segment.
    segmentKey     String @db.Uuid
    chapterVersion Int
    sequence       Int

    kind RevisionKind

    // AI_REJECT là sự kiện đánh giá, không chứa bản dịch mới.
    text String? @db.Text

    sourceText      String  @db.Text
    originalChinese String? @db.Text

    // Giữ nguồn gốc AI qua các lần sửa và duyệt.
    generationId String? @db.Uuid

    // Revision làm cơ sở cho lần sửa, restore hoặc approve này.
    parentRevisionId String? @db.Uuid

    createdAt DateTime @default(now())
    chapter   Chapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade)

    generation Generation? @relation(fields: [generationId], references: [id], onDelete: SetNull)

    parent Revision? @relation("RevisionParent", fields: [parentRevisionId], references: [id], onDelete: SetNull)

    children Revision[] @relation("RevisionParent")

    draftFor    Segment[] @relation("SegmentDraft")
    approvedFor Segment[] @relation("SegmentApproved")
    segment     Segment?  @relation("SegmentRevisions", fields: [segmentId], references: [id], onDelete: SetNull)

    @@unique([segmentKey, sequence])
    @@index([segmentId])
    @@index([chapterId, createdAt])
    @@index([generationId])
    @@index([parentRevisionId])
}
