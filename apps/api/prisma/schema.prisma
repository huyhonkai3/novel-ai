generator client {
    provider = "prisma-client"
    output   = "../src/generated/prisma"
}

datasource db {
    provider = "postgresql"
}

enum GenerationStatus {
    QUEUED
    RUNNING
    SUCCEEDED
    TRUNCATED
    FAILED
}

model Novel {
    id          String    @id @default(uuid()) @db.Uuid
    title       String    @db.VarChar(300)
    description String?   @db.Text
    createdAt   DateTime  @default(now())
    updatedAt   DateTime  @updatedAt
    chapters    Chapter[]
}

model Chapter {
    id              String   @id @default(uuid()) @db.Uuid
    novelId         String   @db.Uuid
    number          Int
    title           String   @db.VarChar(300)
    sourceText      String   @db.Text
    originalChinese String?  @db.Text
    version         Int      @default(1)
    createdAt       DateTime @default(now())
    updatedAt       DateTime @updatedAt

    novel       Novel        @relation(fields: [novelId], references: [id], onDelete: Cascade)
    segments    Segment[]
    generations Generation[]

    @@unique([novelId, number])
}

model Segment {
    id              String  @id @default(uuid()) @db.Uuid
    chapterId       String  @db.Uuid
    position        Int
    startOffset     Int
    endOffset       Int
    sourceText      String  @db.Text
    originalChinese String? @db.Text

    chapter     Chapter      @relation(fields: [chapterId], references: [id], onDelete: Cascade)
    generations Generation[]

    @@unique([chapterId, position])
}

model Generation {
    id        String  @id @default(uuid()) @db.Uuid
    chapterId String  @db.Uuid
    segmentId String? @db.Uuid

    // Giữ ID gốc để tra lịch sử kể cả khi B2 tạo lại segment.
    segmentKey     String @db.Uuid
    chapterVersion Int
    position       Int

    // Snapshot giúp lịch sử không phụ thuộc nội dung chương hiện tại.
    sourceText      String  @db.Text
    originalChinese String? @db.Text
    promptVersion   String
    messages        Json
    parameters      Json

    model        String
    actualModel  String?
    status       GenerationStatus @default(QUEUED)
    output       String           @default("") @db.Text
    finishReason String?
    usage        Json?
    errorCode    String?
    durationMs   Int?

    createdAt  DateTime  @default(now())
    startedAt  DateTime?
    finishedAt DateTime?

    chapter Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

    // Tách lại segment vẫn giữ generation cùng snapshot của nó.
    segment Segment? @relation(fields: [segmentId], references: [id], onDelete: SetNull)

    @@index([segmentId])
    @@index([segmentKey, createdAt])
    @@index([chapterId, createdAt])
    @@index([status, createdAt])
}
